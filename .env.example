# Copy this file to `.env` (gitignored) and adjust values for your machine.
# Loaded by the Prisma CLI natively and by `src/server/data/config.ts` at server runtime.

# SQLite database file (relative paths resolve against prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Base URL used to build absolute QR verify links (server-side only).
WEB_BASE_URL="http://localhost:4200"

# Port of the standalone API process (`npm run api:start`); `ng serve` proxies
# /api/* to it (proxy.conf.json → angular.json serve.options.proxyConfig).
# 3000 avoids the Angular SSR server's default port 4000 (src/server.ts).
API_PORT="3000"
